NODE_ENV=production
PORT=3000
JWT_SECRET=change-this-to-a-secure-random-string-in-production
ADMIN_PASSWORD_HASH=change-this-to-bcrypt-hash-of-admin-password
DATA_DIR=/app/data
UPLOADS_DIR=/app/uploads
SLIDES_DIR=/app/slides
ASSETS_DIR=/app/assets

# OnlyOffice DocumentServer JWT Secret
# IMPORTANT: OnlyOffice has JWT enabled by default
# The backend will use the default secret "verysecretstring" as a fallback for compatibility
# 
# For PRODUCTION use, you MUST configure a secure JWT secret:
#
# Option 1 - Generate a new secure secret (RECOMMENDED):
#   # Step 1: Generate a secure random secret
#   SECRET=$(openssl rand -hex 32)
#   
#   # Step 2: Add to your .env file
#   echo "ONLYOFFICE_JWT_SECRET=$SECRET" >> .env
#   
#   # Step 3: Verify your docker-compose.yml has this configuration for OnlyOffice:
#   #   onlyoffice:
#   #     environment:
#   #       - JWT_SECRET=${ONLYOFFICE_JWT_SECRET:-}
#   
#   # Step 4: Restart containers
#   docker-compose restart
# 
# Option 2 - Use OnlyOffice's existing secret (if already running):
#   ./get-onlyoffice-jwt-secret.sh
#   # Copy the displayed secret and add it below
#
# Security Note: The default secret "verysecretstring" is publicly known and insecure!
ONLYOFFICE_JWT_SECRET=

# Backend URL for OnlyOffice to access files
# IMPORTANT: Must match your backend container name in docker-compose.yml
# Default: http://webinar-backend:3000
# If you changed container_name to "fw-webinar-backend", use: http://fw-webinar-backend:3000
BACKEND_URL=http://webinar-backend:3000

# User/Group IDs for container processes
PUID=1000
PGID=1000
